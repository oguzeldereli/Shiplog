# Optional. Used by /api/repo and /api/fetch-source for GitHub API rate-limit
# headroom. Public-repo reads work without it (60 req/hr unauthenticated; 5000 with).
GITHUB_TOKEN=

# Optional. Powers the keyless "Free" provider option. Get one at
# https://aistudio.google.com/apikey — Gemini's free tier is plenty for a demo.
# If unset, the Free option returns a 503 and users must bring their own key.
GEMINI_FREE_KEY=
