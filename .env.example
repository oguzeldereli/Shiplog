# Optional. Used by /api/repo, /api/items, /api/fetch for GitHub API rate-limit
# headroom. Public-repo reads work without it (60 req/hr unauthenticated; 5000 with).
GITHUB_TOKEN=

# ── Free tier (keyless "Free" provider) ──────────────────────────────────────
# The Free option uses whichever of these is set, preferring GROQ. Groq is
# recommended: free, no credit card, so abuse can never run up a bill. Get one
# at https://console.groq.com/keys
GROQ_FREE_KEY=

# Fallback free backend. Only used if GROQ_FREE_KEY is unset. NOTE: a Gemini key
# with billing enabled is a PAID key — exposing it on the public Free tier means
# abuse costs you money. If you use this, set an enforced quota cap on the
# Generative Language API AND configure Upstash below. Key: https://aistudio.google.com/apikey
GEMINI_FREE_KEY=

# ── Durable rate limiting (protects the Free tier from abuse) ─────────────────
# Without these, rate limiting falls back to in-memory, which does NOT work on
# serverless (resets per instance). Required for real abuse protection in prod.
# Free database at https://upstash.com (Redis → REST API credentials).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
